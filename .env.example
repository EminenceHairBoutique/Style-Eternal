# ═══════════════════════════════════════════════════════════════════════
# Style Eternal — environment variables
# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables.
#
# VITE_-prefixed vars are BUNDLED INTO THE BROWSER — never put secrets there.
# ═══════════════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...                    # anon/public key (browser-safe)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                 # SERVER ONLY — bypasses RLS
# SUPABASE_URL=                                  # optional server-side override

# ── Stripe ───────────────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...                    # SERVER ONLY
STRIPE_WEBHOOK_SECRET=whsec_...                  # from the webhook endpoint config

# ── Shipping (charged at Stripe Checkout; defaults match site microcopy) ─
SHIPPING_STANDARD_CENTS=1000                     # $10 standard below the threshold
FREE_SHIPPING_THRESHOLD_CENTS=15000              # free shipping at/above $150
SHIPPING_COUNTRIES=US                            # comma-separated ISO codes
VITE_FREE_SHIPPING_THRESHOLD=150                 # dollars; drives the cart meter

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=re_...                            # SERVER ONLY
EMAIL_FROM_DOMAIN=shopstyleeternal.com           # must be verified in Resend

# ── AI (Anthropic — stylist chat, fit finder, semantic search) ──────────
ANTHROPIC_API_KEY=sk-ant-...                     # SERVER ONLY

# ── Site ────────────────────────────────────────────────────────────────
VITE_SITE_URL=https://www.shopstyleeternal.com   # canonical origin
# SITE_URL=                                      # optional server-side override

# ── Analytics (all optional — features no-op when unset) ────────────────
VITE_GA_MEASUREMENT_ID=                          # G-XXXXXXXXXX
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=

# ── Error reporting (optional) ───────────────────────────────────────────
VITE_SENTRY_DSN=

# ── E2E tests ────────────────────────────────────────────────────────────
# E2E_BASE_URL=http://localhost:4173
